{
  "database": "Zotero",
  "noteImportFolder": "10-Literature",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [],
  "exportFormats": [
    {
      "name": "Literature",
      "templatePath": "90-Templates/literature.md",
      "outputPathTemplate": "10-Literature/{{citekey}}.md",
      "imageOutputPathTemplate": "assets/{{citekey}}/",
      "imageBaseNameTemplate": "image"
    },
    {
      "name": "Debug",
      "templatePath": "90-Templates/zotero-debug.md",
      "outputPathTemplate": "10-Literature/__DEBUG_{{citekey}}.md",
      "imageOutputPathTemplate": "assets/{{citekey}}/",
      "imageBaseNameTemplate": "image"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": true,
  "whichNotesToOpenAfterImport": "first-imported-note"
}
